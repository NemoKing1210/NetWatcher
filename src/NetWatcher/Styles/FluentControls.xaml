<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Table cell styles only. The DataGrid, its rows, headers, cells, and
        scroll bars keep WPF-UI's own Fluent templates; overriding them is what
        produces the classic-WPF look (grey grippers, square scroll bars,
        opaque row fills).

        Semantic colours reference WPF-UI theme brushes directly at the use
        site. A SolidColorBrush whose Color comes from a DynamicResource
        resolves once and never follows a theme swap.

        Toolbar buttons bind their content foreground directly to the ui:Button
        Foreground. WPF-UI 4.3.0 sets Foreground on the templated parent while
        pressed, and the ContentPresenter's TemplateBinding does not follow, so
        the label falls back to black in the dark theme (lepoco/wpfui#1722,
        fixed by #1733). Revert to Icon/Content when a WPF-UI release includes
        that fix.
    -->

    <Style x:Key="TableCellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TableSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource TableCellText}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="TableDomainText" TargetType="TextBlock" BasedOn="{StaticResource TableCellText}">
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPtr}" Value="True">
                <Setter Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShowGrayed}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TableAddressText" TargetType="TextBlock" BasedOn="{StaticResource TableCellText}">
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="ProcessCount" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
