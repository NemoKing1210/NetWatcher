<ui:FluentWindow x:Class="NetWatcher.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="NetWatcher"
                 Width="1180"
                 Height="760"
                 MinWidth="960"
                 MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="NetWatcher" ShowMaximize="True" ShowMinimize="True" />

        <ui:NavigationView x:Name="Nav"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           IsPaneOpen="True"
                           OpenPaneLength="270">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="ConnectionsItem"
                                       Content="Connections"
                                       Click="Connections_Click" />
                <ui:NavigationViewItem x:Name="DnsItem"
                                       Content="DNS events"
                                       Click="Dns_Click" />
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem x:Name="AllProcessesItem"
                                       Content="All processes"
                                       Click="AllProcesses_Click" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Margin="8,0,0,4"
                               FontWeight="SemiBold"
                               Text="Processes" />
                    <ListView x:Name="ProcessList"
                              MaxHeight="220"
                              BorderThickness="0"
                              DisplayMemberPath="Display"
                              ItemsSource="{Binding Processes}"
                              PreviewMouseLeftButtonUp="ProcessList_PreviewMouseLeftButtonUp"
                              SelectionChanged="ProcessList_SelectionChanged" />
                    <ui:Button x:Name="ThemeItem"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Stretch"
                               Click="Theme_Click"
                               Content="Theme" />
                </StackPanel>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
