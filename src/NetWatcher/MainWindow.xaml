<ui:FluentWindow x:Class="NetWatcher.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:NetWatcher.Localization"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="NetWatcher"
                 Width="1260"
                 Height="780"
                 MinWidth="1180"
                 MinHeight="600"
                 Icon="pack://application:,,,/Assets/logo.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="NetWatcher" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="Nav"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsFooterSeparatorVisible="False"
                           IsPaneToggleVisible="False"
                           IsPaneOpen="True"
                           OpenPaneLength="280">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="ConnectionsItem"
                                       Content="{x:Static loc:Strings.ConnectionsPageTitle}"
                                       Click="Connections_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="DnsItem"
                                       Content="{x:Static loc:Strings.DnsPageTitle}"
                                       Click="Dns_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Server24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="SettingsItem"
                                       Content="{x:Static loc:Strings.SettingsPageTitle}"
                                       Click="Settings_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
