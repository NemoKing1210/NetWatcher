<UserControl x:Class="NetWatcher.Views.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="16,14,16,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom">
            <ui:TextBlock FontTypography="Subtitle" Text="Connections" />
            <ui:TextBlock Margin="10,0,0,1"
                          VerticalAlignment="Bottom"
                          FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Rows.Count, StringFormat={}{0} visible}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="16,10,16,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="PauseButton"
                           Click="Pause_Click"
                           Content="Pause"
                           Icon="{ui:SymbolIcon Symbol=Pause24}"
                           ToolTip="Freeze the view without stopping collection" />
                <ui:Button Margin="8,0,0,0"
                           Click="Clear_Click"
                           Content="Clear"
                           Icon="{ui:SymbolIcon Symbol=Broom24}"
                           ToolTip="Discard the session history" />
                <ui:Button Margin="8,0,0,0"
                           Click="ExportCsv_Click"
                           Content="Export CSV"
                           Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                           ToolTip="Write the current filtered view to a CSV file" />
            </StackPanel>
            <ui:TextBox x:Name="FilterBox"
                        Width="360"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Filter connections"
                        ClearButtonEnabled="True"
                        Icon="{ui:SymbolIcon Symbol=Search24}"
                        PlaceholderText="Filter by domain, IP, or process"
                        TextChanged="FilterBox_TextChanged" />
        </DockPanel>

        <ui:InfoBar x:Name="EtwBanner"
                    Grid.Row="2"
                    Margin="16,10,16,0"
                    IsClosable="False"
                    Message="No administrator rights or the provider is missing. Running in table-polling mode; short-lived connections may be missed."
                    Severity="Warning"
                    Title="ETW is unavailable" />

        <Grid Grid.Row="3" Margin="16,10,16,0">
            <ui:DataGrid x:Name="ConnectionsGrid"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         CanUserReorderColumns="False"
                         CanUserResizeRows="False"
                         ColumnHeaderHeight="36"
                         EnableColumnVirtualization="False"
                         EnableRowVirtualization="True"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         HorizontalScrollBarVisibility="Disabled"
                         IsReadOnly="True"
                         ItemsSource="{Binding Rows}"
                         PreviewMouseRightButtonDown="ConnectionsGrid_PreviewMouseRightButtonDown"
                         RowHeight="34"
                         SelectionMode="Single"
                         VerticalScrollBarVisibility="Auto">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Width="72"
                                        Binding="{Binding Time}"
                                        ElementStyle="{StaticResource TableCellText}"
                                        Header="Time" />
                    <DataGridTextColumn Width="*"
                                        MinWidth="100"
                                        Binding="{Binding ProcessName}"
                                        ElementStyle="{StaticResource TableCellText}"
                                        Header="Process" />
                    <DataGridTextColumn Width="54"
                                        Binding="{Binding Pid}"
                                        ElementStyle="{StaticResource TableSecondaryText}"
                                        Header="PID" />
                    <DataGridTextColumn Width="1.5*"
                                        MinWidth="126"
                                        Binding="{Binding DomainDisplay}"
                                        ElementStyle="{StaticResource TableDomainText}"
                                        Header="Domain" />
                    <DataGridTextColumn Width="1.1*"
                                        MinWidth="104"
                                        Binding="{Binding Ip}"
                                        ElementStyle="{StaticResource TableCellText}"
                                        Header="IP" />
                    <DataGridTextColumn Width="54"
                                        Binding="{Binding Port}"
                                        ElementStyle="{StaticResource TableSecondaryText}"
                                        Header="Port" />
                    <DataGridTextColumn Width="86"
                                        Binding="{Binding ProtocolName}"
                                        ElementStyle="{StaticResource TableCellText}"
                                        Header="Protocol" />
                    <DataGridTextColumn Width="96"
                                        Binding="{Binding State}"
                                        ElementStyle="{StaticResource TableSecondaryText}"
                                        Header="State" />
                    <DataGridTextColumn Width="62"
                                        Binding="{Binding SourceName}"
                                        ElementStyle="{StaticResource TableSecondaryText}"
                                        Header="Src" />
                    <DataGridTextColumn Width="88"
                                        Binding="{Binding LastActivity}"
                                        ElementStyle="{StaticResource TableCellText}"
                                        Header="Last seen" />
                </ui:DataGrid.Columns>
                <ui:DataGrid.ContextMenu>
                    <ContextMenu>
                        <ui:MenuItem Click="CopyIp_Click"
                                     Header="Copy IP"
                                     Icon="{ui:SymbolIcon Symbol=Copy24}" />
                        <ui:MenuItem Click="CopyDomain_Click"
                                     Header="Copy domain"
                                     Icon="{ui:SymbolIcon Symbol=Copy24}" />
                        <ui:MenuItem Click="CopyRow_Click"
                                     Header="Copy row"
                                     Icon="{ui:SymbolIcon Symbol=Copy24}" />
                        <Separator />
                        <ui:MenuItem Click="Details_Click"
                                     Header="Details&#x2026;"
                                     Icon="{ui:SymbolIcon Symbol=Info24}" />
                    </ContextMenu>
                </ui:DataGrid.ContextMenu>
            </ui:DataGrid>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon HorizontalAlignment="Center"
                               FontSize="32"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Symbol="PlugConnected24" />
                <ui:TextBlock Margin="0,10,0,0"
                              HorizontalAlignment="Center"
                              FontTypography="BodyStrong"
                              FontWeight="SemiBold"
                              Text="{Binding EmptyTitle}" />
                <ui:TextBlock Margin="0,2,0,0"
                              HorizontalAlignment="Center"
                              FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{Binding EmptyMessage}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="16,6,16,8"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding StatusLine}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
