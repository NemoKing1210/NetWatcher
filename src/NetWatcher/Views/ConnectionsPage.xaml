<UserControl x:Class="NetWatcher.Views.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NetWatcher.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="16,14,16,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom">
            <ui:TextBlock FontTypography="Subtitle"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Text="{x:Static loc:Strings.ConnectionsPageTitle}" />
            <ui:TextBlock Margin="10,0,0,1"
                          VerticalAlignment="Bottom"
                          FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding VisibleCountText}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="16,10,16,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="PauseButton"
                           AutomationProperties.Name="{x:Static loc:Strings.Pause}"
                           Click="Pause_Click"
                           ToolTip="{x:Static loc:Strings.PauseToolTip}">
                    <StackPanel Orientation="Horizontal"
                                TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}">
                        <ui:SymbolIcon x:Name="PauseIcon"
                                       Margin="0,0,8,0"
                                       Symbol="Pause24" />
                        <TextBlock x:Name="PauseText" Text="{x:Static loc:Strings.Pause}" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Margin="8,0,0,0"
                           AutomationProperties.Name="{x:Static loc:Strings.Clear}"
                           Click="Clear_Click"
                           ToolTip="{x:Static loc:Strings.ClearToolTip}">
                    <StackPanel Orientation="Horizontal"
                                TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}">
                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="Broom24" />
                        <TextBlock Text="{x:Static loc:Strings.Clear}" />
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="ExportButton"
                           Margin="8,0,0,0"
                           AutomationProperties.Name="{x:Static loc:Strings.Export}"
                           Click="Export_Click"
                           ToolTip="{x:Static loc:Strings.ExportToolTip}">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <ui:MenuItem Click="ExportCsv_Click" Header="CSV" />
                            <ui:MenuItem Click="ExportMarkdown_Click" Header="Markdown" />
                            <ui:MenuItem Click="ExportJson_Click" Header="JSON" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                    <StackPanel Orientation="Horizontal"
                                TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}">
                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="ArrowDownload24" />
                        <TextBlock Text="{x:Static loc:Strings.Export}" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <ui:TextBox x:Name="FilterBox"
                            Width="320"
                            AutomationProperties.Name="{x:Static loc:Strings.FilterConnectionsName}"
                            ClearButtonEnabled="True"
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="{x:Static loc:Strings.FilterConnectionsPlaceholder}"
                            TextChanged="FilterBox_TextChanged" />
                <ComboBox x:Name="ProcessFilter"
                          Width="220"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static loc:Strings.FilterByProcess}"
                          ItemsSource="{Binding ProcessOptions}"
                          SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                          ToolTip="{x:Static loc:Strings.ShowConnectionsForProcess}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Width="16"
                                       Height="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Icon.Image}"
                                       Stretch="Uniform" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource ProcessCount}"
                                           Text="{Binding Process.ConnectionCount}" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ui:ToggleSwitch Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="{x:Static loc:Strings.UniqueIps}"
                                 Content="{x:Static loc:Strings.UniqueIps}"
                                 IsChecked="{Binding UniqueIpsOnly, Mode=TwoWay}"
                                 ToolTip="{x:Static loc:Strings.UniqueIpsToolTip}" />
            </StackPanel>
        </DockPanel>

        <ui:InfoBar x:Name="EtwBanner"
                    Grid.Row="2"
                    Margin="16,10,16,0"
                    IsClosable="False"
                    Message="{x:Static loc:Strings.EtwUnavailableMessage}"
                    Severity="Warning"
                    Title="{x:Static loc:Strings.EtwUnavailableTitle}" />

        <Grid Grid.Row="3" Margin="16,10,16,0">
            <ui:DataGrid x:Name="ConnectionsGrid"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         CanUserReorderColumns="False"
                         CanUserResizeRows="False"
                         ColumnHeaderHeight="36"
                         EnableColumnVirtualization="False"
                         EnableRowVirtualization="True"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         HorizontalScrollBarVisibility="Disabled"
                         IsReadOnly="True"
                         ItemsSource="{Binding Rows}"
                         PreviewMouseRightButtonDown="ConnectionsGrid_PreviewMouseRightButtonDown"
                         RowHeight="34"
                         SelectionMode="Single"
                         VerticalScrollBarVisibility="Auto">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Width="72"
                                        Binding="{Binding Time}"
                                        ElementStyle="{StaticResource TableCellText}"
                                        Header="{x:Static loc:Strings.ColumnTime}" />
                    <DataGridTemplateColumn x:Name="ProcessColumn"
                                            Width="*"
                                            MinWidth="120"
                                            Header="{x:Static loc:Strings.ColumnProcess}"
                                            SortMemberPath="ProcessName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="16"
                                           Height="16"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding Icon.Image}"
                                           Stretch="Uniform" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource TableCellText}"
                                               Text="{Binding ProcessName}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="50"
                                        Binding="{Binding Pid}"
                                        ElementStyle="{StaticResource TableSecondaryText}"
                                        Header="{x:Static loc:Strings.ColumnPid}" />
                    <DataGridTextColumn Width="1.5*"
                                        MinWidth="84"
                                        Binding="{Binding DomainDisplay}"
                                        ElementStyle="{StaticResource TableDomainText}"
                                        Header="{x:Static loc:Strings.ColumnDomain}" />
                    <DataGridTextColumn Width="112"
                                        Binding="{Binding Ip}"
                                        ElementStyle="{StaticResource TableCellText}"
                                        Header="{x:Static loc:Strings.ColumnIp}" />
                    <DataGridTextColumn Width="64"
                                        Binding="{Binding Port}"
                                        ElementStyle="{StaticResource TableSecondaryText}"
                                        Header="{x:Static loc:Strings.ColumnPort}" />
                    <DataGridTextColumn Width="96"
                                        Binding="{Binding ProtocolName}"
                                        ElementStyle="{StaticResource TableCellText}"
                                        Header="{x:Static loc:Strings.ColumnProtocol}" />
                    <DataGridTextColumn Width="96"
                                        Binding="{Binding State}"
                                        ElementStyle="{StaticResource TableSecondaryText}"
                                        Header="{x:Static loc:Strings.ColumnState}" />
                    <DataGridTextColumn Width="52"
                                        Binding="{Binding SourceName}"
                                        ElementStyle="{StaticResource TableSecondaryText}"
                                        Header="{x:Static loc:Strings.ColumnSource}" />
                    <DataGridTextColumn Width="108"
                                        Binding="{Binding LastActivity}"
                                        ElementStyle="{StaticResource TableCellText}"
                                        Header="{x:Static loc:Strings.ColumnLastSeen}" />
                </ui:DataGrid.Columns>
                <ui:DataGrid.ContextMenu>
                    <ContextMenu>
                        <ui:MenuItem Click="CopyIp_Click"
                                     Header="{x:Static loc:Strings.CopyIp}"
                                     Icon="{ui:SymbolIcon Symbol=Copy24}" />
                        <ui:MenuItem Click="CopyDomain_Click"
                                     Header="{x:Static loc:Strings.CopyDomain}"
                                     Icon="{ui:SymbolIcon Symbol=Copy24}" />
                        <ui:MenuItem Click="CopyRow_Click"
                                     Header="{x:Static loc:Strings.CopyRow}"
                                     Icon="{ui:SymbolIcon Symbol=Copy24}" />
                        <Separator />
                        <ui:MenuItem Click="Details_Click"
                                     Header="{x:Static loc:Strings.Details}"
                                     Icon="{ui:SymbolIcon Symbol=Info24}" />
                    </ContextMenu>
                </ui:DataGrid.ContextMenu>
            </ui:DataGrid>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon HorizontalAlignment="Center"
                               FontSize="32"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Symbol="PlugConnected24" />
                <ui:TextBlock Margin="0,10,0,0"
                              HorizontalAlignment="Center"
                              FontTypography="BodyStrong"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              Text="{Binding EmptyTitle}" />
                <ui:TextBlock Margin="0,2,0,0"
                              HorizontalAlignment="Center"
                              FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{Binding EmptyMessage}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="16,6,16,8"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding StatusLine}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
