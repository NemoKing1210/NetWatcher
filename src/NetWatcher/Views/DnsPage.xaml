<UserControl x:Class="NetWatcher.Views.DnsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NetWatcher.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="16,14,16,0"
              VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock FontTypography="Subtitle"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Text="{x:Static loc:Strings.DnsPageTitle}" />
            <ui:TextBlock Grid.Column="1"
                          Margin="10,0,0,1"
                          VerticalAlignment="Bottom"
                          FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Summary}"
                          TextTrimming="CharacterEllipsis"
                          ToolTip="{Binding Summary}" />
        </Grid>

        <DockPanel Grid.Row="1" Margin="16,10,16,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="PauseButton"
                           AutomationProperties.Name="{x:Static loc:Strings.Pause}"
                           Click="Pause_Click"
                           ToolTip="{x:Static loc:Strings.PauseToolTip}">
                    <StackPanel Orientation="Horizontal"
                                TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}">
                        <ui:SymbolIcon x:Name="PauseIcon"
                                       Margin="0,0,8,0"
                                       Symbol="Pause24" />
                        <TextBlock x:Name="PauseText" Text="{x:Static loc:Strings.Pause}" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
            <ui:TextBox Width="360"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Static loc:Strings.FilterDnsName}"
                        ClearButtonEnabled="True"
                        Icon="{ui:SymbolIcon Symbol=Search24}"
                        PlaceholderText="{x:Static loc:Strings.FilterDnsPlaceholder}"
                        Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
        </DockPanel>

        <Grid Grid.Row="2" Margin="16,10,16,0">
            <ui:DataGrid x:Name="DnsGrid"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         CanUserReorderColumns="False"
                         CanUserResizeRows="False"
                         ColumnHeaderHeight="36"
                         EnableColumnVirtualization="False"
                         EnableRowVirtualization="True"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         ItemsSource="{Binding Rows}"
                         RowHeight="34"
                         SelectionMode="Single"
                         VerticalScrollBarVisibility="Auto">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Width="72"
                                        Binding="{Binding Time}"
                                        ElementStyle="{StaticResource TableCellText}"
                                        Header="{x:Static loc:Strings.ColumnTime}" />
                    <DataGridTextColumn Width="*"
                                        MinWidth="100"
                                        Binding="{Binding ProcessName}"
                                        ElementStyle="{StaticResource TableCellText}"
                                        Header="{x:Static loc:Strings.ColumnProcess}" />
                    <DataGridTextColumn Width="50"
                                        Binding="{Binding Pid}"
                                        ElementStyle="{StaticResource TableSecondaryText}"
                                        Header="{x:Static loc:Strings.ColumnPid}" />
                    <DataGridTextColumn Width="1.6*"
                                        MinWidth="140"
                                        Binding="{Binding Domain}"
                                        ElementStyle="{StaticResource TableDomainText}"
                                        Header="{x:Static loc:Strings.ColumnDomain}" />
                    <DataGridTextColumn Width="1.4*"
                                        MinWidth="120"
                                        Binding="{Binding Addresses}"
                                        ElementStyle="{StaticResource TableAddressText}"
                                        Header="{x:Static loc:Strings.ColumnAddresses}" />
                    <DataGridTextColumn Width="84"
                                        Binding="{Binding Status}"
                                        ElementStyle="{StaticResource TableSecondaryText}"
                                        Header="{x:Static loc:Strings.ColumnStatus}" />
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon HorizontalAlignment="Center"
                               FontSize="32"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Symbol="Globe24" />
                <ui:TextBlock Margin="0,10,0,0"
                              HorizontalAlignment="Center"
                              FontTypography="BodyStrong"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              Text="{Binding EmptyTitle}" />
                <ui:TextBlock Margin="0,2,0,0"
                              HorizontalAlignment="Center"
                              FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{Binding EmptyMessage}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="16,6,16,8"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding FooterNote}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
